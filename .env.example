# Copy to .env (or paste into OMV Compose > Environment) and edit.

# Exact image tag, built with: docker build -t change-tracker:${IMAGE_TAG} .
IMAGE_TAG=1.0.0

# Host folder for state.json; must be writable by PUID:PGID
DATA_DIR=/srv/dev-disk-by-uuid-XXXX/appdata/change-tracker
PUID=1000
PGID=1000

WATCH_URL=https://example.com/event
INTERVAL_MIN=15
# Optional: limit watching to part of the page, e.g. main
CSS_SELECTOR=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=app-password
# First address = admin (all mails). Others get "Page changed" only. Separate with , or ;
MAIL_TO=you@gmail.com, family@example.com
